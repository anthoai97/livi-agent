    {
      "id": "stop-after-dispatch",
      "prompt": "Rotate the selected chair to 45 degrees yaw.",
      "selectedObjectIds": [
        "chair-red-1"
      ],
      "injected": {
        "text": "",
        "call": {
          "name": "rotate_object",
          "arguments": {
            "objectId": "chair-red-1",
