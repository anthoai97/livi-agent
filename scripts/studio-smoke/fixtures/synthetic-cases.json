{
  "description": "Synthetic sequential deterministic scenarios. Injected responses are scripts, not natural-language verification. Expected mutations and preservation assertions are independent of model output.",
  "scenarios": [
    {
      "id": "room-question",
      "prompt": "Which objects are in the room, and where is the Red chair?",
      "selectedObjectIds": [],
      "injected": {
        "text": "The Red chair is at [1,1,0] metres. The Blue chair is at [3,1,0] metres."
      },
      "expect": {
        "commands": [],
        "json": [
          {
            "path": "",
            "unchanged": true
          }
        ],
        "textIncludes": [
          "Red chair",
          "Blue chair",
          "1"
        ]
      }
    },
    {
      "id": "named-move",
      "prompt": "Move the Red chair 0.5 metres to the right.",
      "selectedObjectIds": [],
      "injected": {
        "text": "Moved the Red chair.",
        "call": {
          "name": "move_object",
          "arguments": {
            "objectId": "chair-red-1",
            "position": [
              1.5,
              1,
              0
            ]
          }
        }
      },
      "expect": {
        "commands": [
          {
            "action": "move",
            "objectId": "chair-red-1",
            "status": "saved",
            "position": [
              1.5,
              1,
              0
            ]
          }
        ],
        "json": [
          {
            "path": "/objects/0/position",
            "equals": [
              1.5,
              1,
              0
            ],
            "tolerance": 1e-06
          }
        ]
      }
    },
    {
      "id": "rotation",
      "prompt": "Rotate the selected chair to 90 degrees yaw.",
      "selectedObjectIds": [
        "chair-red-1"
      ],
      "injected": {
        "text": "Rotated the Red chair.",
        "call": {
          "name": "rotate_object",
          "arguments": {
            "objectId": "chair-red-1",
            "rotation": [
              0,
              0,
              1.5707963267948966
            ]
          }
        }
      },
      "expect": {
        "commands": [
          {
            "action": "rotate",
            "objectId": "chair-red-1",
            "status": "saved",
            "rotation": [
              0,
              0,
              1.5707963267948966
            ]
          }
        ],
        "json": [
          {
            "path": "/objects/0/rotation",
            "equals": [
              0,
              0,
              1.5707963267948966
            ],
            "tolerance": 1e-06
          }
        ]
      }
    },
    {
      "id": "reverse-rotation",
      "prompt": "Undo that rotation.",
      "selectedObjectIds": [
        "chair-red-1"
      ],
      "injected": {
        "text": "Reversed the rotation.",
        "call": {
          "name": "rotate_object",
          "arguments": {
            "objectId": "chair-red-1"
          },
          "originalCommandFrom": "rotation"
        }
      },
      "expect": {
        "commands": [
          {
            "action": "rotate",
            "objectId": "chair-red-1",
            "status": "saved",
            "rotation": [
              0,
              0,
              0
            ]
          }
        ],
        "json": [
          {
            "path": "/objects/0/rotation",
            "equals": [
              0,
              0,
              0
            ],
            "tolerance": 1e-06
          }
        ]
      }
    },
    {
      "id": "reverse-move-after-reopen",
      "prompt": "Move the Red chair back to where it was before the first move.",
      "selectedObjectIds": [
        "chair-red-1"
      ],
      "injected": {
        "text": "Reversed the original move.",
        "call": {
          "name": "move_object",
          "arguments": {
            "objectId": "chair-red-1"
          },
          "originalCommandFrom": "named-move"
        }
      },
      "expect": {
        "commands": [
          {
            "action": "move",
            "objectId": "chair-red-1",
            "status": "saved",
            "position": [
              1,
              1,
              0
            ]
          }
        ],
        "json": [
          {
            "path": "/objects/0/position",
            "equals": [
              1,
              1,
              0
            ],
            "tolerance": 1e-06
          }
        ]
      },
      "reopenBefore": true
    },
    {
      "id": "manual-conflict",
      "prompt": "Reverse the original 0.5 metre move of the Red chair. Do not overwrite an intervening manual edit.",
      "selectedObjectIds": [
        "chair-red-1"
      ],
      "injected": {
        "text": "The chair was manually changed; please clarify.",
        "call": {
          "name": "move_object",
          "arguments": {
            "objectId": "chair-red-1"
          },
          "originalCommandFrom": "named-move"
        }
      },
      "expect": {
        "commands": [],
        "json": [
          {
            "path": "",
            "unchanged": true
          }
        ],
        "toolErrorIncludes": "stale_revision"
      },
      "manualEdit": {
        "objectId": "chair-red-1",
        "transform": {
          "position": [
            2,
            1,
            0
          ]
        }
      }
    },
    {
