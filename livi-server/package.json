{
  "name": "@livi/server",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "dev": "node --env-file-if-exists=../.env --import tsx --watch src/main.ts",
    "start": "node --env-file-if-exists=../.env dist/main.js",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@earendil-works/chord": "workspace:*",
    "@earendil-works/pi-agent-core": "workspace:*",
    "@earendil-works/pi-ai": "workspace:*",
    "@earendil-works/pi-server": "workspace:*",
    "@earendil-works/pi-session-backend-sqlite-node": "workspace:*",
    "@google/genai": "1.52.0",
    "@livi/decorator-agent": "workspace:*",
    "pg": "8.23.0",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "@earendil-works/pi-client": "workspace:*",
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.1"
  }
}
