{
  "name": "@earendil-works/pi-session-backend-postgres-node",
  "version": "0.85.1",
  "description": "PostgreSQL session backend",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "clean": "node -e \"import('node:fs/promises').then(fs=>fs.rm('dist',{recursive:true,force:true}))\"",
    "build": "tsgo -p tsconfig.build.json && node scripts/copy-migrations.mjs",
    "test": "vitest --run",
    "coverage": "vitest --run --coverage",
    "prepublishOnly": "npm run clean && npm run build",
    "typecheck": "tsgo -p tsconfig.test.json --noEmit"
  },
  "author": "Earendil Works",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/earendil-works/pi.git",
    "directory": "packages/session-backends/postgres-node"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "workspace:*",
    "@earendil-works/pi-agent-core": "workspace:*",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.9",
    "vitest": "4.1.9",
    "@types/pg": "8.23.1"
  }
}
