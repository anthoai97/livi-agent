# Server-only credentials. Never prefix secrets with VITE_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
HOST=127.0.0.1
PORT=3001
# Opt-in structured server-terminal diagnostics; restart the server after changing.
# LIVI_DEBUG=1
# Comma-separated exact browser origins for a separately running Studio; empty allows only same-origin chat.
# STUDIO_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional absolute directory; defaults to this workspace's .data
# LIVI_DATA_DIR=/absolute/path/to/livi-data
# Optional PostgreSQL catalog for a dedicated read-only role. Absent: chat still works; catalog tools report unavailable.
# A malformed URL prevents server startup. Never expose this value to the browser.
# CATALOG_DATABASE_URL=postgres://livi_catalog_read@127.0.0.1:5432/postgres
